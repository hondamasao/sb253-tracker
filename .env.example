# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local — it's already in .gitignore.
#
# In Vercel, set these under Project Settings → Environment Variables,
# with separate values for Production and Preview (Preview should use
# test-mode keys for Stripe/Inngest — see docs/11-deployment-strategy.md).

# ---------------------------------------------------------------------------
# Required now (M0) — database + file storage
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string (URI, "Transaction" pooler mode)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="" # server-only secret — never expose to the browser

# ---------------------------------------------------------------------------
# Background jobs (Inngest)
# ---------------------------------------------------------------------------

# Local dev only — tells the SDK to talk to the local Inngest Dev Server
# (`npx inngest-cli dev`) instead of Inngest Cloud. Without this, the app
# assumes production/cloud mode and /api/inngest returns a 500 until real
# keys are set below. Do NOT set this in Vercel.
INNGEST_DEV="1"

# Required once deployed to Inngest Cloud (Preview/Production in Vercel);
# not needed for local dev.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Optional now — error monitoring (Sentry safely no-ops without a DSN)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN="" # only needed for source-map upload; safe to leave blank locally

# ---------------------------------------------------------------------------
# M1 — scan engine data sources
# ---------------------------------------------------------------------------

# Required to run the M1b AI agents for real (see docs/18-m1b-ai-agent-architecture.md).
# Without it, those agents fail gracefully (agent_runs.status = "failed",
# a clear error message) rather than the scan crashing — and the
# integration tests that call the real API skip cleanly instead of failing.
ANTHROPIC_API_KEY=""

# Optional — the Lighthouse agent works without a key at a much lower
# shared quota; a real key just raises that quota.
GOOGLE_PAGESPEED_API_KEY=""

# ---------------------------------------------------------------------------
# M1c — spend ceilings and rate limiting (docs/19-m1c-security-and-evaluation.md)
# ---------------------------------------------------------------------------
# Three independent ceilings guarding three different failure modes. All are
# optional; the defaults below apply when unset, and all can be changed
# without a redeploy.

# One runaway scan. PROVISIONAL AND UNVERIFIED — see lib/budget.ts. Two
# estimates of a normal scan's real cost disagree by 3-6x, and this default
# must be reset from measured data after the first golden-set run rather
# than by estimating again.
SCAN_COST_CEILING_USD="0.15"

# Many individually-compliant scans. A per-IP request limit does not bound
# spend: 2,000 legitimate scans still cost real money. Enforced at the queue
# boundary, before anything is enqueued.
DAILY_SPEND_CAP_USD="25"

# A long prompt-tuning loop. Judging the golden set on Opus 5 costs
# materially more per run than a scan does.
EVAL_SPEND_CAP_USD="10"

# Free scans per IP per hour. This is a CONVERSION question as much as a
# security one — the free scan is the top of the funnel and shared NATs
# (offices, cafes, CGNAT) will trip it. Env-configurable so it can be raised
# from funnel data without a redeploy. See lib/rate-limit.ts.
SCANS_PER_IP_PER_HOUR="3"

# ---------------------------------------------------------------------------
# M3 — payments + email (not required until the payment flow ships)
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
